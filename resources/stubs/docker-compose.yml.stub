# Project and container names are global on a Docker host, so they carry the
# app's name: two apps on one server can each own a "{{ slug }}" stack.
name: {{ project }}

services:
    {{ slug }}:
        image: your/image:tag
        container_name: {{ project }}
        restart: unless-stopped
        # Publish on loopback. Docker writes its own firewall rules and bypasses
        # UFW, so a publish without an address is reachable from the internet.
        ports:
            - '127.0.0.1:${{{ upper }}_PORT:-8080}:8080'
        environment:
            EXAMPLE_SETTING: ${{{ upper }}_EXAMPLE:-value}
        healthcheck:
            test: ["CMD", "wget", "--no-verbose", "--spider", "http://127.0.0.1:8080/health"]
            interval: 30s
            timeout: 5s
            retries: 3
            start_period: 10s
        volumes:
            - '{{ project }}-data:/data'
        logging:
            driver: json-file
            options:
                max-size: 50m
                max-file: '3'

volumes:
    {{ project }}-data:
        driver: local
