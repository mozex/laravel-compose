<?php

declare(strict_types=1);

namespace {{ namespace }};

use Illuminate\Support\Facades\Config;
use Mozex\Compose\Stack;

class {{ class }} extends Stack
{
    /**
     * Values written to this stack's env file before every redeploy. Read them
     * from config so they trace back to the app's own environment, and never
     * edit the generated file by hand: the next redeploy overwrites it.
     *
     * @return array<string, string|int|float|bool|null>
     */
    public function environment(): array
    {
        return [
            '{{ upper }}_PORT' => (int) Config::get('services.{{ slug }}.port', 8080),
        ];
    }

    /**
     * Whether this host manages the stack. Machines without Docker, CI, and
     * environments pointing at an external service return false.
     */
    public function enabled(): bool
    {
        return (bool) Config::get('services.{{ slug }}.manage_container', false);
    }
}
